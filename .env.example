# LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Search (optional — degrades gracefully to Reddit fallback)
GOOGLE_CSE_API_KEY=your-google-cse-key-here
GOOGLE_CSE_CX=your-search-engine-id-here

# Database (only needed for web app, not batch mode)
MONGODB_URI=mongodb+srv://...

# Auth (only needed for web app, not batch mode)
SESSION_SECRET=your-session-secret-here

# Server
PORT=5000
NODE_ENV=development

# Frontend (only needed for web app)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
